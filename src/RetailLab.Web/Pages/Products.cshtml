@page
@model RetailLab.Web.Pages.ProductsModel
@{
    ViewData["Title"] = "Catalogue";
}

<h1>Catalogue</h1>

@if (Model.Products.Count == 0)
{
    <p>No products are available right now. Please check back later.</p>
}
else
{
    <ul class="cards">
        @foreach (var product in Model.Products)
        {
            <li class="card">
                <h2><a asp-page="/Product" asp-route-sku="@product.Sku">@product.Description</a></h2>
                <p class="sku">Product code: @product.Sku</p>
                <p class="price">@product.PriceDisplay</p>
                <p class="availability @product.AvailabilityTone">@product.Availability</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (Model.FavouriteSkus.Contains(product.Sku))
                    {
                        <form method="post" asp-page="/Favourites" asp-page-handler="Remove">
                            <input type="hidden" name="sku" value="@product.Sku" />
                            <input type="hidden" name="returnUrl" value="@Request.Path" />
                            <button type="submit">Remove from favourites</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page="/Favourites" asp-page-handler="Add">
                            <input type="hidden" name="sku" value="@product.Sku" />
                            <input type="hidden" name="returnUrl" value="@Request.Path" />
                            <button type="submit">Add to favourites</button>
                        </form>
                    }
                    <form method="post" asp-page="/Basket" asp-page-handler="Add">
                        <input type="hidden" name="sku" value="@product.Sku" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="returnUrl" value="@Request.Path" />
                        <button type="submit">Add to basket</button>
                    </form>
                }
                else
                {
                    <p><a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path">Sign in to save</a></p>
                    <p><a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path">Sign in to add to basket</a></p>
                }
            </li>
        }
    </ul>
}
