@page "/Products/{sku}"
@model RetailLab.Web.Pages.ProductModel
@{
    ViewData["Title"] = Model.Product?.Description ?? "Not found";
}

@if (Model.Product is null)
{
    <h1>Product not found</h1>
    <p>That product does not exist or is no longer available.</p>
    <p><a asp-page="/Products">Back to the catalogue</a></p>
}
else
{
    <nav aria-label="Breadcrumb"><a asp-page="/Products">Catalogue</a> / @Model.Product.Sku</nav>
    <h1>@Model.Product.Description</h1>
    <p class="sku">Product code: @Model.Product.Sku</p>
    <p class="price">@Model.Product.PriceDisplay</p>
    <p class="availability @Model.Product.AvailabilityTone">@Model.Product.Availability</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        if (Model.IsFavourite)
        {
            <form method="post" asp-page="/Favourites" asp-page-handler="Remove">
                <input type="hidden" name="sku" value="@Model.Product.Sku" />
                <input type="hidden" name="returnUrl" value="@Request.Path" />
                <button type="submit">Remove from favourites</button>
            </form>
        }
        else
        {
            <form method="post" asp-page="/Favourites" asp-page-handler="Add">
                <input type="hidden" name="sku" value="@Model.Product.Sku" />
                <input type="hidden" name="returnUrl" value="@Request.Path" />
                <button type="submit">Add to favourites</button>
            </form>
        }
        <form method="post" asp-page="/Basket" asp-page-handler="Add">
            <input type="hidden" name="sku" value="@Model.Product.Sku" />
            <input type="hidden" name="returnUrl" value="@Request.Path" />
            <div class="field quantity-field">
                <label for="quantity">Quantity</label>
                <input type="number" id="quantity" name="quantity" value="1" min="1" />
            </div>
            <button type="submit">Add to basket</button>
        </form>
    }
    else
    {
        <p><a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path">Sign in to save</a></p>
        <p><a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path">Sign in to add to basket</a></p>
    }
    @if (Model.Product.IsOutOfStock)
    {
        <p>Currently unavailable. Please check back later.</p>
    }
}
