@page
@model RetailLab.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<h1>Create your account</h1>
<p>One account keeps your favourites separate from every other customer.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password"></span>
    </div>
    <div class="field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button class="button" type="submit">Create account</button>
</form>

<p>Already have an account? <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>.</p>
