@page
@model RetailLab.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1>Something went wrong</h1>
<p>The catalogue could not complete that request. Please try again later.</p>
@if (Model.ShowRequestId)
{
    <p class="sku">Request ID: @Model.RequestId</p>
}
<p><a asp-page="/Index">Back to the home page</a></p>
