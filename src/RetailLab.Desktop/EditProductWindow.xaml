<Window x:Class="RetailLab.Desktop.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Edit product"
        Width="480"
        Height="600"
        MinWidth="420"
        MinHeight="480"
        Background="#F4F6F2"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17221D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5E6B64" />
        <SolidColorBrush x:Key="AccentBrush" Color="#176B4D" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="#AEB8B2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="Bold" Text="Edit product" />
            <TextBlock x:Name="SkuHeadingTextBlock"
                       Margin="0,8,0,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       Text="The SKU cannot be changed. Stock can only be changed through the audited adjustment workflow."
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Description" />
                <TextBox x:Name="DescriptionTextBox"
                         Margin="0,6,0,4"
                         automation:AutomationProperties.Name="Edit description"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="64" />
                <TextBlock Margin="0,0,0,16"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Required. Up to 300 characters." />

                <TextBlock FontWeight="SemiBold" Text="Price" />
                <TextBox x:Name="PriceTextBox"
                         Margin="0,6,0,4"
                         automation:AutomationProperties.Name="Edit price"
                         ToolTip="Nonnegative amount, for example 9.99." />
                <TextBlock Margin="0,0,0,4"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Required. A nonnegative amount such as 9.99." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="14,10"
                Background="#E7ECE8"
                CornerRadius="6">
            <TextBlock x:Name="StatusTextBlock"
                       automation:AutomationProperties.LiveSetting="Polite"
                       Text="Edit the product details."
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SaveChangesButton"
                    MinWidth="160"
                    automation:AutomationProperties.Name="Save product changes"
                    Content="Save changes"
                    IsDefault="True"
                    Click="SaveChangesButton_Click" />
            <Button x:Name="CancelButton"
                    Margin="12,0,0,0"
                    MinWidth="120"
                    automation:AutomationProperties.Name="Cancel product edit"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
