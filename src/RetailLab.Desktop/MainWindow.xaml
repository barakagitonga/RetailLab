<Window x:Class="RetailLab.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="RetailLab inventory"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        Background="#F4F6F2"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17221D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5E6B64" />
        <SolidColorBrush x:Key="AccentBrush" Color="#176B4D" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="#AEB8B2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="30" FontWeight="Bold" Text="Inventory workspace" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Review exact local stock and record an audited adjustment while offline." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Padding="1"
                    Background="White"
                    BorderBrush="#D7DDD9"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="InventoryGrid"
                          automation:AutomationProperties.Name="Inventory products"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionChanged="InventoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:0.00}}" Width="90" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="75" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    Padding="24"
                    Background="White"
                    BorderBrush="#D7DDD9"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="Bold" Text="Adjust selected stock" />
                        <TextBlock Margin="0,8,0,20"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Every adjustment records the change, resulting quantity, reason, actor, and UTC time." />

                        <TextBlock FontWeight="SemiBold" Text="Selected product" />
                        <TextBlock x:Name="SelectedSkuTextBlock"
                                   Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="Select a product" />
                        <TextBlock x:Name="SelectedDescriptionTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedStockTextBlock"
                                   Margin="0,8,0,20"
                                   FontWeight="SemiBold" />

                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Quantity change" />
                        <TextBox x:Name="QuantityChangeTextBox"
                                 automation:AutomationProperties.Name="Quantity change"
                                 ToolTip="Use a positive number to add stock or a negative number to remove stock." />
                        <TextBlock Margin="0,5,0,16"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Examples: 5 adds five; -3 removes three." />

                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Reason" />
                        <TextBox x:Name="ReasonTextBox"
                                 automation:AutomationProperties.Name="Adjustment reason"
                                 MaxLength="200"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="82" />

                        <Button x:Name="ApplyAdjustmentButton"
                                Margin="0,20,0,0"
                                Content="Apply adjustment"
                                IsDefault="True"
                                IsEnabled="False"
                                Click="ApplyAdjustmentButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="14,10"
                Background="#E7ECE8"
                CornerRadius="6">
            <TextBlock x:Name="StatusTextBlock"
                       automation:AutomationProperties.LiveSetting="Polite"
                       Text="Loading local inventory..."
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
