<Window x:Class="RetailLab.Desktop.AdjustmentHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Adjustment history"
        Width="820"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        Background="#F4F6F2"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17221D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5E6B64" />
        <SolidColorBrush x:Key="AccentBrush" Color="#176B4D" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="Bold" Text="Adjustment history" />
            <TextBlock x:Name="ProductHeadingTextBlock"
                       Margin="0,8,0,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Newest adjustments first. Times are shown in UTC."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,16"
                Padding="1"
                Background="White"
                BorderBrush="#D7DDD9"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <DataGrid x:Name="HistoryGrid"
                          automation:AutomationProperties.Name="Adjustment history"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time (UTC)"
                                            Binding="{Binding CreatedAtUtcDisplay}"
                                            Width="160" />
                        <DataGridTextColumn Header="Change"
                                            Binding="{Binding QuantityChangeDisplay}"
                                            Width="80" />
                        <DataGridTextColumn Header="Resulting stock"
                                            Binding="{Binding ResultingQuantity}"
                                            Width="115" />
                        <DataGridTextColumn Header="Reason"
                                            Binding="{Binding Reason}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Actor"
                                            Binding="{Binding ActorIdentifier}"
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyStateTextBlock"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}"
                           Text="No adjustments have been recorded for this product yet."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14,10"
                Background="#E7ECE8"
                CornerRadius="6">
            <TextBlock x:Name="StatusTextBlock"
                       automation:AutomationProperties.LiveSetting="Polite"
                       Text="Loading adjustment history..."
                       TextWrapping="Wrap" />
        </Border>

        <Button x:Name="CloseButton"
                Grid.Row="3"
                Margin="0,16,0,0"
                MinWidth="140"
                HorizontalAlignment="Right"
                automation:AutomationProperties.Name="Close adjustment history"
                Content="Close"
                IsCancel="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
